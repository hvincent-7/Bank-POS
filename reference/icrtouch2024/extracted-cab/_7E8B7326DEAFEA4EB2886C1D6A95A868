local tMonthLengths = {[1]=31,[2]=28,[3]=31,[4]=30,[5]=31,[6]=30,[7]=31,[8]=31,[9]=30,[10]=31,[11]=30,[12]=31 };
// MonthNames are in language.def 222~233 ~local tMonthNames = {[1]="JANUARY",[2]="FEBRUARY",[3]="MARCH",[4]="APRIL",[5]="MAY",[6]="JUNE",[7]="JULY",[8]="AUGUST",[9]="SEPTEMBER",[10]="OCTOBER",[11]="NOVEMBER",[12]="DECEMBER" };
local bDebugPrinting = false;

