generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  WAITER
  BAR
  MANAGER
}

enum OrderStatus {
  PENDING
  SENT
  RUNG_IN
  VOID
}

model Staff {
  id        String    @id @default(cuid())
  name      String
  pinHash   String
  role      StaffRole @default(WAITER)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  ordersTaken   Order[] @relation("StaffOrders")
  ordersRungIn  Order[] @relation("StaffRungIn")
}

model Area {
  id     String  @id @default(cuid())
  name   String  @unique
  tables Table[]
}

model Table {
  id     String  @id @default(cuid())
  label  String
  areaId String
  area   Area    @relation(fields: [areaId], references: [id])
  orders Order[]

  @@unique([areaId, label])
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  name        String
  pricePence  Int
  tillCode    String
  active      Boolean      @default(true)

  modifierGroupLinks MenuItemModifierGroup[]
  orderItems         OrderItem[]
}

model ModifierGroup {
  id        String     @id @default(cuid())
  name      String
  min       Int        @default(0)
  max       Int        @default(1)
  modifiers Modifier[]
  itemLinks MenuItemModifierGroup[]
}

model Modifier {
  id              String             @id @default(cuid())
  groupId         String
  group           ModifierGroup      @relation(fields: [groupId], references: [id])
  name            String
  priceDeltaPence Int                @default(0)
  orderItemLinks  OrderItemModifier[]
}

model MenuItemModifierGroup {
  menuItemId     String
  menuItem       MenuItem      @relation(fields: [menuItemId], references: [id])
  modifierGroupId String
  modifierGroup  ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([menuItemId, modifierGroupId])
}

model Order {
  id         String      @id @default(cuid())
  clientUuid String      @unique
  staffId    String
  staff      Staff       @relation("StaffOrders", fields: [staffId], references: [id])
  tableId    String
  table      Table       @relation(fields: [tableId], references: [id])
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  syncedAt   DateTime?
  rungInAt   DateTime?
  rungInById String?
  rungInBy   Staff?      @relation("StaffRungIn", fields: [rungInById], references: [id])

  items OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  qty             Int
  unitPricePence  Int
  note            String?

  modifiers OrderItemModifier[]
}

model OrderItemModifier {
  id              String    @id @default(cuid())
  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId      String
  modifier        Modifier  @relation(fields: [modifierId], references: [id])
  priceDeltaPence Int
}
