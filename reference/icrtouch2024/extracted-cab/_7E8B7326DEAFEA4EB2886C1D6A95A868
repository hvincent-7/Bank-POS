/**********************************************************************
RoundDate
Rounds a date that been adjusted by stuff
**********************************************************************/

function RoundDate(tDate)
{
    while(tDate.sec < 0)
    {
        tDate.sec += 60;
        tDate.min--;
    }
    while(tDate.sec > 59)
    {
        tDate.sec -= 60;
        tDate.min++;
    }
    while(tDate.min < 0)
    {
        // if we're -ve minutes
        // adjust the minutes by 60 and take an hour off
        tDate.min += 60;
        tDate.hour--;
    }
    while(tDate.min > 59)
    {
        // if we're more minutes than fit in an hour
        // adjust the minutes by 60 and add an hour on
        tDate.min -= 60;
        tDate.hour++;
    }
    while(tDate.hour < 0)
    {
        // if we have gone back past midnight
        // adjust date to day before
        tDate.hour += 24;
        tDate.day--;
    }
    while(tDate.hour > 23)
    {
        // if we're in tomorrow
        tDate.hour -= 24;
        tDate.day++;
    }
    local nDaysInMonth = tMonthLengths[tDate.month];
    // is it a feb in a leap year?
    if (tDate.month == 2 && IsLeapYear(tDate.year))
    {
        nDaysInMonth++;
    }
    while (tDate.day > nDaysInMonth)
    {
        // adding that many days has put us off the end of the month
        tDate.day -= nDaysInMonth;
        tDate.month++;
        if (tDate.month > 12)
        {
            // gone off the end of the year
            tDate.month = 1;
            tDate.year++;
        }
        nDaysInMonth = tMonthLengths[tDate.month];
         // is it a feb in a leap year?
        if (tDate.month == 2 && IsLeapYear(tDate.year))
        {
            nDaysInMonth++;
        }
    }
    return tDate;
}

/**********************************************************************
IsLeapYear
works out whether the supplied year is a leap year and returns a boolean
**********************************************************************/

function IsLeapYear(nYear)
{
    if (nYear % 400 == 0)
    {
        // 400th years are leap years
        return true;
    }
    if (nYear % 100 == 0)
    {
        // hundredth years that aren't 400th years are NOT leap years
        return false;
    }
    if (nYear % 4 == 0)
    {
        // every fourth year that isn't a hundredth year is a lear year
        return true;
    }
    return false;
}

/**********************************************************************
CalcWeekDay
Works out which day of the week it is assuming only that day month year are correct
**********************************************************************/
function CalcWeekDay(tDate)
{
    local tSysData = ICR_GetSystemData();
    if(tSysData.VERSIONID < 6000)
    {
        // prior to version ID 6000 date tables had months starting from 0
        tDate.month += 1;
    }
    // lookup table because 2.6 nd 0.2 are hard work
    local monthVals = {[1]=0,[2]=3,[3]=2,[4]=5,[5]=0,[6]=3,[7]=5,[8]=1,[9]=4,[10]=6,[11]=2,[12]=4};
    local mVal = monthVals[tDate.month];
    local C = tDate.year / 100; // century half of the year
    local Y = tDate.year % 100; // year within that century
    if (tDate.month < 3)
    {
        // the year starts in march apparently so jan/feb are last year
        Y -= 1;
    }
    local wDay = (tDate.day + mVal + Y + (Y/4) + (C/4) - (2*C)) % 7;
    if (wDay <0)
    {
        wDay = 7 + wDay;
    }
    tDate.wday <- wDay;
    if(tSysData.VERSIONID < 6000)
    {
        // if we adjusted it then put it back
        tDate.month -= 1;
    }
    return tDate;
}

function LongDateString(tDate)
{
    local tSysData = ICR_GetSystemData();
    if(tSysData.VERSIONID < 6000)
    {
        // prior to version ID 6000 date tables had months starting from 0
        tDate.month += 1;
    }
    
    local szDateString = "";
    
    szDateString += tDate.day
    szDateString += " " 
    szDateString += ICR_GetLanguageText(tDate.month+221); //tMonthNames[tDate.month]
    szDateString += " "
    szDateString += tDate.year;
    
    return szDateString;
}



/********************************************************************************
* DateToSQLDate(tDate)
* Convert Date to SQL Looking date.
*********************************************************************************/

function DateToSQLDate(tDate , szDateDash = "-", szDTSeperator = " ", szTimeColon = ":")
{
    // date() to SQL TimeStamp yyyy-mm-dd HH:mm:ss
    local szDate = "";
    // if tDate table not valid then this will failed. return null
    try
    {
        szDate += tDate.year;
        szDate += szDateDash;
        if(tDate.month < 10)szDate += "0";
        szDate += tDate.month;
        szDate += szDateDash;
        if(tDate.day < 10)szDate += "0";
        szDate += tDate.day;
        
        szDate += szDTSeperator;
        
        if(tDate.hour < 10)szDate += "0";
        szDate += tDate.hour;
        szDate += szTimeColon;
        if(tDate.min < 10)szDate += "0";
        szDate += tDate.min;
        szDate += szTimeColon;
        if(tDate.sec < 10)szDate += "0";
        szDate += tDate.sec;     
    }
    catch(e)
    {
        szDate = null;
    }
    if(bDebugPrinting)print("DateToUnixDate "+szDate);
    return szDate;
}


/********************************************************************************
* SQLDateToDate(szDate)
* Get sql yyyy-mm-dd hh:mm:ss to date() table. returns null if format not valid.
*********************************************************************************/

function SQLDateToDate(szDate , szSeperators = ". :,-/")
{
    // if the len smaller than 15 too short to be valid date. 
    if(szDate.len() < 15)return null;
    local tDate = {};
    try
    {
        // Chop it up
        local aSplit = split(szDate,szSeperators); // example result will be array ["2016","11","08","13","59","40"]
        if(bDebugPrinting)printtable(aSplit);
        // Populate date fields
        tDate.year  <- aSplit[0];
        tDate.month <- aSplit[1];
        tDate.day   <- aSplit[2];     
        tDate.hour  <- aSplit[3];
        tDate.min   <- aSplit[4];
        if(5 in aSplit)
        {
            tDate.sec <- aSplit[5];
        }
        else
        {
            // passed time without seconds
            tDate.sec <- 0;
        }
        // Make integers
        if(bDebugPrinting)print("Making ints");
        foreach( idx , val in tDate)
        {
            tDate[idx] <- val.tointeger();
        }
        // TODO: Range Checking day 0~31 etc?
          
        // Add yday. number of days from start of the year.
        local nDate = (( tDate.day * 1000000 ) + ( tDate.month * 10000 ) +  tDate.year);
        local nYearStartDate = 1010000 +  tDate.year;
          
        if(bDebugPrinting)print("Calc days from "+nYearStartDate+ " to "+nDate);
          
        local nyday = DateIntCompare(  nYearStartDate , nDate ); 
        tDate.yday  <- nyday;
        // Calc wday  wikipedia formula( Gregorian calendar)
        local tMonthOffset = {  [1]  = 0,
                                [2]  = 3,
                                [3]  = 3,
                                [4]  = 6,
                                [5]  = 1,
                                [6]  = 4,
                                [7]  = 6,
                                [8]  = 2,
                                [9]  = 5, 
                                [10] = 0,
                                [11] = 3,
                                [12] = 5 };
        local nCentOffset = (tDate.year / 100) % 4;
        local nYY = tDate.year % 100;
         
        // wikipedia formula = ( d + MonthOffSet + yy + (yy / 4) + CentOffset ) % 7
        if(bDebugPrinting)print("day "+ tDate.day +" + MonthOffset " + tMonthOffset[tDate.month] + " + YY " + nYY + "( "+ nYY +" div 4 ) " + nCentOffset + " ) % 7");
          
        local nWeekDay = (tDate.day + tMonthOffset[tDate.month] + nYY + (  nYY / 4  ) + nCentOffset ) % 7;
        // Wikipedia formula wday 0=Sat ~ 6 = Fri  ~ Etal is 1 less.  0 = Sun ~ 6 = Sat
        nWeekDay--; // Etal one day less than wiki
        if(nWeekDay == -1)nWeekDay = 6;
          
        // Store wday
        tDate.wday <- nWeekDay;
    }
    catch(e)
    {
        if(bDebugPrinting)print(e);
        return null;
    }
    
    return tDate;
}
