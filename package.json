{
  "name": "bank-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first POS PWA for beer-garden service, with a manual-till bridge and an ICRTouch seam for future integration.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @bank-pos/api prisma migrate dev",
    "db:seed": "pnpm --filter @bank-pos/api prisma db seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
